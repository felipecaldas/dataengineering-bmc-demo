{
  "TradeCloseToReplenishment": {
    "Type": "Folder",
    "ControlmServer": "IN01",
    "OrderMethod": "Manual",
    "Application": "RetailDataOps",
    "SubApplication": "StoreReplenishment",
    "Description": "Trade day close to WMS acknowledgement with a 06:00 pick-wave SLA",
    "Variables": [
      {
        "DEMO_DATE": "%%ODATE"
      },
      {
        "DEMO_ISO_DATE": "2026-08-14"
      },
      {
        "ASN_PATH": "/home/azureuser/retail-data-demo/runtime/asn/ASN_20260814.csv"
      },
      {
        "ACK_PATH": "/home/azureuser/retail-data-demo/runtime/wms/ack/REPLEN_ACK_20260814.txt"
      }
    ],
    "WaitForStoreEODThreshold": {
      "Type": "Job:Dummy",
      "Description": "Wait for the Kafka-derived 98.0 percent store EOD readiness event",
      "eventsToWaitFor": {
        "Type": "WaitForEvents",
        "Events": [
          {
            "Event": "RETAIL_EOD_READY_%%DEMO_DATE",
            "Date": "OrderDate"
          }
        ]
      },
      "eventsToDelete": {
        "Type": "DeleteEvents",
        "Events": [
          {
            "Event": "RETAIL_EOD_READY_%%DEMO_DATE",
            "Date": "OrderDate"
          }
        ]
      }
    },
    "WaitSupplierASN": {
      "Type": "Job:FileWatcher:Create",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Path": "%%ASN_PATH",
      "SearchInterval": "5",
      "TimeLimit": "90",
      "MinimumSize": "10B",
      "Description": "Supplier ASN non-arrival is visible as a distinct upstream failure"
    },
    "LandKafkaEvents": {
      "Type": "Job:Command",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Command": "/home/azureuser/retail-data-demo/controlm/scripts/run_stage.sh bronze %%DEMO_DATE",
      "Description": "Idempotently land Kafka POS and EOD events plus the supplier ASN in the local source plane"
    },
    "ValidateSourceContract": {
      "Type": "Job:Command",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Command": "/home/azureuser/retail-data-demo/controlm/scripts/run_stage.sh silver %%DEMO_DATE",
      "Description": "Enforce the ASN schema contract before promoting the six validated source tables"
    },
    "SyncDeltaSources": {
      "Type": "Job:Command",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Command": "/home/azureuser/retail-data-demo/controlm/scripts/run_stage.sh azure-sync %%DEMO_DATE",
      "Description": "Copy one validated, date-scoped source snapshot into Azure Databricks Delta"
    },
    "DbtBronze": {
      "Type": "Job:DBT",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "ConnectionProfile": "${DBT_CONNECTION_PROFILE}",
      "DBT Job Id": "${DBT_BRONZE_JOB_ID}",
      "Run Comment": "Control-M retail demo bronze for %%DEMO_ISO_DATE",
      "Override Job Commands": "checked",
      "Variables": [
        {
          "UCM-DefineCommands-N001-element": "dbt build --select tag:bronze --vars '{trading_date: %%DEMO_ISO_DATE}'"
        }
      ],
      "Status Polling Frequency": "10",
      "Failure Tolerance": "2",
      "Description": "Native dbt plug-in job: build and test the staging views presented as the Azure bronze layer"
    },
    "DbtSilver": {
      "Type": "Job:DBT",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "ConnectionProfile": "${DBT_CONNECTION_PROFILE}",
      "DBT Job Id": "${DBT_SILVER_JOB_ID}",
      "Run Comment": "Control-M retail demo silver for %%DEMO_ISO_DATE",
      "Override Job Commands": "checked",
      "Variables": [
        {
          "UCM-DefineCommands-N001-element": "dbt build --select tag:silver --vars '{trading_date: %%DEMO_ISO_DATE}'"
        }
      ],
      "Status Polling Frequency": "10",
      "Failure Tolerance": "2",
      "Description": "Native dbt plug-in job: build and test the intermediate tables presented as the Azure silver layer"
    },
    "DbtGold": {
      "Type": "Job:DBT",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "ConnectionProfile": "${DBT_CONNECTION_PROFILE}",
      "DBT Job Id": "${DBT_GOLD_JOB_ID}",
      "Run Comment": "Control-M retail demo gold for %%DEMO_ISO_DATE",
      "Override Job Commands": "checked",
      "Variables": [
        {
          "UCM-DefineCommands-N001-element": "dbt build --select tag:gold --vars '{trading_date: %%DEMO_ISO_DATE}'"
        }
      ],
      "Status Polling Frequency": "10",
      "Failure Tolerance": "2",
      "Description": "Native dbt plug-in job: build and test the business-facing Databricks gold marts",
      "RerunLimit": {
        "Every": "1",
        "Units": "Minutes",
        "Times": "2"
      },
      "ActionIfFailure": {
        "Type": "If",
        "CompletionStatus": "NOTOK",
        "RetryFromPointOfFailure": {
          "Type": "Action:Rerun"
        }
      }
    },
    "ExportAzureOrder": {
      "Type": "Job:Command",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Command": "/home/azureuser/retail-data-demo/controlm/scripts/run_stage.sh azure-replen %%DEMO_DATE",
      "Description": "Export the tested Azure gold result into the deterministic WMS CSV contract"
    },
    "DeliverToWMS": {
      "Type": "Job:Command",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Command": "/home/azureuser/retail-data-demo/controlm/scripts/run_stage.sh deliver %%DEMO_DATE",
      "Description": "Idempotent delivery to the WMS SFTP endpoint"
    },
    "ConfirmWMSIntake": {
      "Type": "Job:FileWatcher:Create",
      "Host": "fmo-azureuser",
      "RunAs": "azureuser",
      "Path": "%%ACK_PATH",
      "SearchInterval": "5",
      "TimeLimit": "20",
      "MinimumSize": "10B",
      "Description": "The service ends only after WMS acknowledges the order"
    },
    "SLA_PickWave": {
      "Type": "Job:SLAManagement",
      "Host": "fmo-azureuser",
      "ServiceName": "Store Replenishment",
      "ServicePriority": "1",
      "RunAs": "azureuser",
      "JobRunsDeviationsTolerance": "2",
      "CompleteBy": {
        "Time": "06:00",
        "Days": "0"
      },
      "ServiceActions": {
        "ForecastLate": {
          "Type": "If:SLA:ServiceIsLate",
          "NotifyOps": {
            "Type": "Action:SLA:Notify",
            "Severity": "VeryUrgent",
            "Message": "%%SERVICE_NAME forecast late. Due %%SERVICE_DUE_TIME; expected %%SERVICE_EXPECTED_END_TIME; problematic %%PROBLEMATIC_JOBS"
          }
        }
      }
    },
    "EodToLanding": {
      "Type": "Flow",
      "Sequence": ["WaitForStoreEODThreshold", "LandKafkaEvents"]
    },
    "AsnToLanding": {
      "Type": "Flow",
      "Sequence": ["WaitSupplierASN", "LandKafkaEvents"]
    },
    "ProcessingFlow": {
      "Type": "Flow",
      "Sequence": [
        "LandKafkaEvents",
        "ValidateSourceContract",
        "SyncDeltaSources",
        "DbtBronze",
        "DbtSilver",
        "DbtGold",
        "ExportAzureOrder",
        "DeliverToWMS",
        "ConfirmWMSIntake",
        "SLA_PickWave"
      ]
    }
  }
}
