# Compose identity and demo defaults
COMPOSE_PROJECT_NAME=retail-data-demo
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
# Leave empty for repeatable manual demo runs; set to 0 1 * * * for daily scheduling.
DEMO_AIRFLOW_SCHEDULE=
# Non-production shared signing keys; replace them outside this isolated demo.
AIRFLOW_JWT_SECRET=retail-demo-jwt-signing-key-2026-control-plane-a-0123456789-abcdefghij
AIRFLOW_API_SECRET_KEY=retail-demo-log-signing-key-2026-control-plane-a-9876543210-jihgfedcba
DEMO_TRADING_DATE=2026-08-14
STORE_COUNT=325
SKU_COUNT=2000
TXN_PER_STORE=200
DEMO_SEED=20260814
# Use localhost for clients on this VM. Set a private DNS name/IP only when
# Kafka must be reached from another machine on a trusted network.
KAFKA_ADVERTISED_HOST=localhost

# Local data plane. These defaults are intentionally non-production credentials.
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail
WMS_USER=demo
WMS_PASSWORD=demo

# The enrolled Control-M agent remains on the host. Override if its logical name changes.
CTM_AGENT_HOST=fmo-azureuser
CTM_SERVER=IN01
CTM_RUN_AS=azureuser
CTM_ENV=se-dev

# Optional real-Azure profile (not needed for the self-contained demo).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=kmart_demo
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=kmart-demo
AZURE_STORAGE_KEY=
